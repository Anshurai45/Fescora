# Local frontend only. Do not set this on Vercel when the API lives in the same Vercel project.
VITE_API_URL=http://localhost:5000
VITE_RAZORPAY_KEY_ID=your_test_key_id

# Vercel serverless API variables. Keep the secret server-side only.
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_AMOUNT=35400
